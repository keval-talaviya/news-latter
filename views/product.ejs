<%- include('header.ejs') %>

    <div id="overlay" class="overlay"></div>
    <div class="layout">
        <main class="content">
            <div>
                <div class="nav navbar navbar-expand-xl navbar-light iq-navbar">
                    <div class="container-fluid navbar-inner">
                        <h5 class="site-menu-title">NEWS</h5>
                        <ul class="mb-2 navbar-nav ms-auto align-items-center navbar-list mb-lg-0">
                            <li class="nav-item dropdown">
                                <a class="p-0 ps-3 nav-link d-flex align-items-center position-relative" href="#"
                                    id="profile-setting" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="/images/64.jpg" alt="User-Profile"
                                        class="theme-color-default-img img-fluid avatar avatar-40 avatar-rounded"
                                        loading="lazy" />
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profile-setting">
                                    <li>
                                        <a class="dropdown-item" href="/logout">
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                        <a id="btn-toggle" href="#" class="sidebar-toggler break-point-sm">
                            <i class="ri-menu-line ri-xl"></i>
                        </a>
                    </div>
                </div>
                <section class="categorylist-section mt-5">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-header">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                        <h4 class="mb-0">News</h4>
                                        <a href="/admin/news/create" class="add-btn">
                                            Add New News
                                        </a>
                                    </div>
                                </div>
                                <div class="card-body table-responsive">
                                    <table id="orderlisttable" class="table table-striped" style="width: 100%">
                                        <thead>
                                            <tr>
                                                <th>Slug</th>
                                                <th>Views</th>
                                                <th>Banner</th>
                                                <th>Date</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% for(let product of data) { %>
                                                <tr>
                                                    <td><%- product.slug %></td>
                                                    <td><%- product.view %></td>
                                                    <td><img src="<%- product.banner %>" class="rounded-xl" width="100">
                                                    </td>
                                                    <td>
                                                        <% d=new Date(product.createdAt); hover=d.getHours()> 12 ?
                                                            d.getHours() - 12 : d.getHours();
                                                            countdate = d.getDate()+'-'+(d.getMonth() +
                                                            1)+'-'+d.getFullYear();
                                                            %>
                                                            <%- countdate %>
                                                    </td>
                                                    <td class="text-end">
                                                        <a href="/admin/news/edit/<%= product.id %>"
                                                            
                                                            class="btn btn-sm btn-neutral me-2">Edit</a>

                                                        <a href="/admin/news/delete/<%= product.id %>"
                                                            class="btn btn-sm btn-square btn-neutral text-danger-hover">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </a>

                                                    </td>
                                                </tr>
                                                <%}%>

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
        <div class="overlay"></div>
    </div>



    <%- include('footer.ejs') %>